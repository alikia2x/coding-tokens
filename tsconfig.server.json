{
	"compilerOptions": {
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"paths": {
			"@shared/*": ["./shared/*"],
			"electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/main/paths": [
				"./.hutch/devkit/api/sdks/main/entries/paths.ts"
			],
			"electrobun/main/app-menu": [
				"./.hutch/devkit/api/sdks/main/entries/app-menu.ts"
			]
		}
	},
	"include": [
		"server/**/*.ts",
		"src/**/*.ts",
		"shared/**/*.ts",
		"scripts/**/*.ts",
		"desktop/**/*.ts"
	]
}
