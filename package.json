{
	"name": "coding-tokens",
	"version": "0.4.0",
	"private": true,
	"type": "module",
	"description": "Local token usage reports for coding harnesses",
	"bin": {
		"coding-tokens": "./src/cli.ts"
	},
	"scripts": {
		"start": "bun run src/cli.ts",
		"web": "bun run build && bun run server/index.ts",
		"web:serve": "bun run server/index.ts",
		"dev": "bun run scripts/dev.ts",
		"build": "vite build",
		"build:cli": "bun run scripts/build-cli.ts",
		"setup:signing": "bun run scripts/setup-signing.ts",
		"check": "biome check --config-path=biome.json .",
		"format": "biome format --config-path=biome.json --write .",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
		"test": "bun test",
		"test:fixtures": "bun test tests/fixtures",
		"test:unit": "bun test tests/unit",
		"test:integration": "bun test tests/integration",
		"test:dogfood": "bun test tests/dogfood",
		"release": "bun run scripts/release.ts",
		"dev:app": "bun run build && bunx electrobun dev",
		"build:app": "bun run build && bunx electrobun build --env=stable",
		"preview": "bun run build && bun run server/index.ts",
		"dev:app:watch": "bun run build && bunx electrobun dev --watch"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"electrobun": "2.0.4",
		"happy-dom": "^21.0.4",
		"shadcn": "4.22.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.4"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@fontsource-variable/schibsted-grotesk": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@radix-ui/colors": "^3.0.0",
		"@tanstack/react-query": "^5.107.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cn": "^0.5.2",
		"date-fns": "^4.4.0",
		"i18next": "^27.1.1",
		"lucide-react": "^1.72.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.1",
		"react-i18next": "^18.0.1",
		"react-markdown": "^10.1.0",
		"react-router": "^8.5.1",
		"recharts": "3.10.1",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.7.0"
	}
}
